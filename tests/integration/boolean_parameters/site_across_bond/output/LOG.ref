------------------------------------------------------------
* Non relational properties:
------------------------------------------------------------
A(a) => [ A(a[.]) v A(a[x.B]) v A(a[z.C]) [ only if P ] ]
A(b) => [ A(b{u}) v A(b{p}) ]
B(x) => [ B(x[.]) v B(x[a.A]) ]
B(y) => [ B(y{u}) v B(y{p}) ]
C(k) => [ C(k{u}) v C(k{p}) [ only if ((.not.J).or.Q).and.P ] ]
C(z) => [ C(z[.]) v C(z[a.A]) [ only if P ] ]

------------------------------------------------------------
* Relational properties:
------------------------------------------------------------
A() =>
   [
	  A(a[.],b{p}) [ only if P.and.J.and.Q ]
	v A(a[x.B],b{p})
	v A(a[z.C],b{p}) [ only if P.and.J.and.Q ]
	v A(a[.],b{u})
	v A(a[x.B],b{u})
	v A(a[z.C],b{u}) [ only if P ]
   ]
B(y{p}) => B(x[a.A],y{p})
C() =>
   [
	  C(k{p},z[.]) [ only if ((.not.J).or.Q).and.P ]
	v C(k{p},z[a.A]) [ only if P.and.J.and.Q ]
	v C(k{u},z[.])
	v C(k{u},z[a.A]) [ only if P ]
   ]
------------------------------------------------------------
* Properties in connected agents
------------------------------------------------------------
A(a[1]),B(x[1]) => 
	[
		  A(a[1],b{p}),B(x[1],y{u})
		v A(a[1],b{p}),B(x[1],y{p})
		v A(a[1],b{u}),B(x[1],y{u})
	]
A(a[1]),C(z[1]) => 
	[
		  A(a[1],b{p}),C(k{u},z[1]) [ only if P ]
		v A(a[1],b{p}),C(k{p},z[1]) [ only if P.and.J.and.Q ]
		v A(a[1],b{u}),C(k{u},z[1]) [ only if P ]
		v A(a[1],b{u}),C(k{p},z[1]) [ only if P.and.J.and.Q ]
	]
