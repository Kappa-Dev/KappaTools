* Non relational properties:
------------------------------------------------------------
A(t) => [ A(t[.]) v A(t[t.A]) ]
A(z) => [ A(z[.]) v A(z[z.A]) ]
B(t) => [ B(t[.]) v B(t[z.B]) ]
B(z) => [ B(z[.]) v B(z[t.B]) ]
C(t) => [ C(t[.]) v C(t[z.C]) ]
C(z) => [ C(z[.]) v C(z[t.C]) ]
D(t) => [ D(t[.]) v D(t[z.D]) v D(t[t.D]) ]
D(z) => [ D(z[.]) v D(z[t.D]) ]
E(t) => [ E(t[.]) v E(t[t.E]) ]
E(z) => [ E(z[.]) v E(z[z.E]) ]
F(t) => [ F(t[.]) v F(t[z.F]) ]
F(z) => [ F(z[.]) v F(z[z.F]) v F(z[t.F]) ]

------------------------------------------------------------
* Relational properties:
------------------------------------------------------------
A(z[z.A]) <=> A(t[t.A])
B(z[t.B]) <=> B(t[z.B])
D(t,z[t.D]) => D(t[t.D],z[t.D])
F(t,z[t.F]) => F(t[.],z[t.F])
F(t,z[.]) => F(t[.],z[.])
------------------------------------------------------------
* Properties in connected agents
------------------------------------------------------------
------------------------------------------------------------
* Properties of pairs of bonds
------------------------------------------------------------
A(t[t.A],z[z.A]) => A(t[2],z[1]),A(t[2],z[1])
B(t[z.B],z[t.B]) => [ B(t[2],z[1]),B(t[1],z[2]) v B(t[1],z[1]) ]
C(t[z.C],z[t.C]) => C(t[2],z[1]),C(t[1]),C(z[2])
E(t[t.E],z[z.E]) => E(t[2],z[1]),E(z[1]),E(t[2])
------------------------------------------------------------
* Properties of counters
------------------------------------------------------------
