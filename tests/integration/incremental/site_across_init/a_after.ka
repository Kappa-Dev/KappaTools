%agent: C(x y{u p}) 

%init: 10 A(x[1]),B(x[1]) 
%init: 10 C(x[1],y{p}[.]),D(x[1]) 
%init: 10 E(x[1]),F(x[1])
%init: 10 G(x[1]),H(x[1])

A(x[1] y{u}[.]),B(x[1] y{u}[.]) -> A(x[1] y{p}[.]),B(x[1] y{p}[.]) @1
A(x[1] y{p}[.]),B(x[1] y{p}[.]) -> A(x[1] y{u}[.]),B(x[1] y{u}[.]) @1

C(x[1] y{p}[.]),D(x[1] y{u}[.]) -> C(x[1] y{u}[.]),D(x[1] y{p}[.]) @1
C(x[1] y{p}[.]),D(x[1] y{u}[.]) -> C(x[1] y{u}[.]),D(x[1] y{u}[.]) @1

E(x[1] y{u}[.]),F(x[1] y{u}[.]) -> E(x[1] y{p}[.]),F(x[1] y{p}[.]) @1
E(x[1] y{p}[.]),F(x[1] y{p}[.]) -> E(x[1] y{u}[.]),F(x[1] y{u}[.]) @1

G(x[1] y{u}[.]),H(x[1] y{u}[.]) -> G(x[1] y{p}[.]),H(x[1] y{p}[.]) @1
G(x[1] y{p}[.]),H(x[1] y{p}[.]) -> G(x[1] y{u}[.]),H(x[1] y{u}[.]) @1